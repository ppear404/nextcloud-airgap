# Certs
NC_APP_CERT_FILE=./certs/<nextcloud-dev.lan>
NC_APP_CERT_KEY=./certs/<nextcloud-dev.lan-key.pem>
TALK_CERT_KEY=./certs/<talk-dev.lan.pem>
TALK_CERT_KEY=./certs/<talk-dev.lan-key.pem>
COLLAB_CERT_FILE=./certs/<collabora-dev.lan.pem>
COLLAB_CERT_KEY=./certs/<collabora-dev.lan-key.pem>
ROOT_CA_CERT=./certs/<mkcert-rootCA.crt>

# db service
MYSQL_ROOT_PASSWORD=<enter a root password>
MYSQL_PASSWORD=<enter a sql password>
MYSQL_DATABASE=<nextcloud>
MYSQL_USER=<nextcloud>
# MYSQL_HOST=db  --- IGNORE ---

# nextcloud service
NEXTCLOUD_TRUSTED_DOMAINS=<nextcloud-dev.lan>
TRUSTED_PROXIES=<172.23.0.0/16> # typically nextclouds docker network ip range
OVERWRITEHOST=nextcloud-dev.lan
OVERWRITEPROTOCOL=https
OVERWRITECLIURL=<https://nextcloud-dev.lan>
FORWARDED_FOR_HEADERS=HTTP_X_FORWARDED_FOR


# Extra hosts for Nextcloud container stack (Commented out for debugging)
APP_EXTRA_HOST1=talk-dev.lan:<container host ip addr>
APP_EXTRA_HOST2=nextcloud-dev.lan:<container host ip addr>
APP_EXTRA_HOST3=collabora-dev.lan:<container host ip addr>

# Harp Variables
HP_SHARED_KEY=<a_very_very_secure_password>
NC_INSTANCE_URL=https://nextcloud-dev.lan
HP_EXAPPS_ADDRESS=0.0.0.0:8780
HP_LOG_LEVEL=debug

# Nextcloud High Performance Backend Variables
NC_DOMAIN=nextcloud-dev.lan
TALK_PORT=3478
TALK_HOST=talk-dev.lan
TURN_SECRET=<your secret key string>
SIGNALING_SECRET=<your secret key string>
INTERNAL_SECRET=<your secret key string>

# Nextcloud Collabora Variables
aliasgroup1=https://nextcloud-dev.lan
aliasgroup2=https://10\\.1\\.[0-9]+\\.[0-9]+   # this was used for the private lan access to collab

# AppAPI Bootstrap Defaults
APPAPI_DAEMON_NAME=harp_proxy_docker
APPAPI_ENABLE=true
APPAPI_DAEMON_DISPLAY_NAME=HaRP Proxy (Docker)
APPAPI_DEPLOY_METHOD=docker-install
APPAPI_DAEMON_PROTOCOL=http
APPAPI_DAEMON_HOST=nextcloud-harp:8780
APPAPI_HARP_FRP_ADDRESS=nextcloud-harp:8782
APPAPI_DAEMON_NETWORK=proxy
APPAPI_COMPUTE_DEVICE=cpu
APPAPI_SET_DEFAULT=true
APPAPI_ENABLE_HARP=true
APPAPI_HARP_DOCKER_SOCKET_PORT=24000
APPAPI_NEXTCLOUD_URL=https://nextcloud-dev.lan
APPAPI_HARP_EXAPP_DIRECT=false
